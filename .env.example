# MCP server settings, all optional. The server works without any of them.
#
# Nothing loads this file automatically. It documents the variables you can set
# in your shell before starting the server.
#
# This is not where model provider credentials go. Those belong in
# config/workbench.env, created from config/workbench.env.example.

# Optional. Raises the GitHub API rate limit. The server lists resources from
# GitHub by default, and unauthenticated requests are limited per IP address,
# so set this if several people share a network.
GITHUB_TOKEN=

# Set to true to use only the snapshot in corpus/fixtures and make no network
# requests. The default is to list from GitHub and fall back to the snapshot if
# that fails; every result reports which of the two it came from.
LEARNING_ASSISTANT_OFFLINE=false

# The source manifest to load.
LEARNING_ASSISTANT_SOURCES=corpus/sources.yaml
