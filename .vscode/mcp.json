{
  "servers": {
    "stjude-learning-assistant": {
      "type": "stdio",
      "command": "uv",
      "args": ["run", "learning-assistant", "stdio"],
      "env": {
        "LEARNING_ASSISTANT_OFFLINE": "false",
        "LEARNING_ASSISTANT_SOURCES": "${workspaceFolder}/corpus/sources.yaml"
      }
    }
  }
}
